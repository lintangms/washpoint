			"item": [
				{
					"name": "1.1 Register Regular User (Role: user)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var json = pm.response.json();",
									"if (json.data && json.data.access_token) {",
									"    pm.collectionVariables.set('user_token', json.data.access_token);",
									"    pm.collectionVariables.set('active_token', json.data.access_token);",
									"}"
								],
								"type": "text/javascript"
